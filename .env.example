# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Secret key from Stripe Dashboard for creating Checkout Sessions on the backend
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_ANNUAL_PRICE_ID: Optional Stripe Price ID for £69.99/yr subscription (fallback inline price used if omitted)
STRIPE_ANNUAL_PRICE_ID="price_..."

# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY: Public key for client-side Stripe initialization (Expo / Web)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_pk_live_51UUrCf4zcRf8LhgQF5LsWrrFd2wpw51X54trXw0FoEa9rwiMrNMGMQeSWmCUxLPIWnniB3IxssWICWg8Xr9Cptbg00XBXxtTdo"

# STRIPE_PUBLISHABLE_KEY: Legacy alias for client-side Stripe initialization
STRIPE_PUBLISHABLE_KEY="pk_test_pk_live_51UUrCf4zcRf8LhgQF5LsWrrFd2wpw51X54trXw0FoEa9rwiMrNMGMQeSWmCUxLPIWnniB3IxssWICWg8Xr9Cptbg00XBXxtTdo"

# STRIPE_WEBHOOK_SECRET: Secret for verifying webhook event signatures from Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_..."

# AWIN_PUBLISHER_ID: Your Awin Publisher ID (e.g. 1234567) to receive basket share from Sainsbury's, Asda, Morrisons & Waitrose
AWIN_PUBLISHER_ID="YOUR_AWIN_PUBLISHER_ID"

# TESCO_PARTNER_TAG: Optional Tesco Partner / Affiliate Tracking ID
TESCO_PARTNER_TAG="YOUR_TESCO_TAG"




